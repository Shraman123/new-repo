# Anthropic API key used by lib/agent (see lib/config.ts for model names)
ANTHROPIC_API_KEY=

# Postgres connection string (Neon or Supabase free tier)
DATABASE_URL=

# Password for the /admin dashboard (Phase 6)
ADMIN_PASSWORD=

# Salt used to hash phone numbers before storage — never log or commit the real value
HASH_SALT=

# When true, all agent tools filter out data marked verified:false
DEMO_MODE=false
